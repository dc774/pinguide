ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Sessions: a long random string (python -c "import secrets; print(secrets.token_hex(32))").
# Without it, sign-ins reset whenever the server restarts.
SECRET_KEY=

# Google sign-in (optional; the button is hidden without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email sign-in links via Resend (without a key, links are printed to the server log)
RESEND_API_KEY=
MAIL_FROM=Pinguide <signin@pinguide.info>

# Optional "Buy me a coffee" link (https only); hidden when empty
PINGUIDE_SUPPORT_URL=

# Optional overrides (defaults shown, approved 2026-11-20)
# PINGUIDE_DB_PATH=vector_store/app/pinguide.db
# PINGUIDE_ANSWER_EFFORT=medium
# PINGUIDE_SEARCHES_PER_ANSWER=3
# PINGUIDE_SEARCHES_PER_DAY_ANON=25
# PINGUIDE_SEARCHES_PER_DAY_USER=100
# PINGUIDE_SEARCHES_PER_DAY_SITE=300
# PINGUIDE_LINK_MINUTES=15
# PINGUIDE_EMAILS_PER_HOUR=5
# PINGUIDE_SESSION_DAYS=30
